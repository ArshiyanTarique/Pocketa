# Copy to `.env.local` and fill in, or run:
#   npm run connect-supabase -- <project-url> <publishable-key>
#
# Without these two, Pocketa runs fully offline with no account, and Settings
# says so plainly.
#
# Supabase dashboard -> Project Settings -> API keys -> "Publishable key".
# That key is meant to be public: it ships inside the browser bundle, and
# row-level security is what protects the data. Never use a secret key here.
#
# The variable is still called ANON_KEY for older projects, whose browser key is
# a JWT labelled `anon`. Either shape works.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
